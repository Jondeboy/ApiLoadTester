<UserControl x:Class="ApiLoadTester.App.Views.CertificateConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ApiLoadTester.App.ViewModels"
             xmlns:models="clr-namespace:ApiLoadTester.Core.Models;assembly=ApiLoadTester.Core"
             xmlns:local="clr-namespace:ApiLoadTester.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:CertificateConfigViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel Margin="4">

        <TextBlock Text="Client Certificate (mTLS)" Style="{StaticResource SectionHeaderText}"/>
        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                   Text="The API requires a client certificate. Choose a .pfx file or a certificate already installed in your Windows account's certificate store."/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton Content="No client certificate" GroupName="CertKind" Margin="0,0,16,0"
                         IsChecked="{Binding Kind, Converter={x:Static local:EnumEqualsConverter.Instance}, ConverterParameter={x:Static models:CertificateSourceKind.None}}"/>
            <RadioButton Content=".pfx file" GroupName="CertKind" Margin="0,0,16,0"
                         IsChecked="{Binding Kind, Converter={x:Static local:EnumEqualsConverter.Instance}, ConverterParameter={x:Static models:CertificateSourceKind.PfxFile}}"/>
            <RadioButton Content="Windows certificate store" GroupName="CertKind"
                         IsChecked="{Binding Kind, Converter={x:Static local:EnumEqualsConverter.Instance}, ConverterParameter={x:Static models:CertificateSourceKind.WindowsStore}}"/>
        </StackPanel>

        <!-- .pfx file mode -->
        <StackPanel Visibility="{Binding Kind, Converter={x:Static local:EnumVisibilityConverter.Instance}, ConverterParameter={x:Static models:CertificateSourceKind.PfxFile}}">
            <TextBlock Text="Certificate file (.pfx / .p12)" Style="{StaticResource FieldLabelText}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding PfxFilePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowsePfxFileCommand}"/>
            </Grid>
            <TextBlock Style="{StaticResource HintText}"
                       Text="Looks in the app's Certificates folder by default - drop your .pfx there, or browse anywhere."/>

            <TextBlock Text="Certificate password" Style="{StaticResource FieldLabelText}"/>
            <PasswordBox x:Name="PfxPasswordBox"/>
            <CheckBox Content="Remember password (encrypted for this Windows account only)" Margin="0,8,0,0"
                      IsChecked="{Binding RememberPassword}"/>
        </StackPanel>

        <!-- Windows store mode -->
        <StackPanel Visibility="{Binding Kind, Converter={x:Static local:EnumVisibilityConverter.Instance}, ConverterParameter={x:Static models:CertificateSourceKind.WindowsStore}}">
            <TextBlock Text="Certificate (CurrentUser\My store)" Style="{StaticResource FieldLabelText}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding StoreThumbprintOrSubject, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Select..." Style="{StaticResource SecondaryButton}" Command="{Binding PickFromWindowsStoreCommand}"/>
            </Grid>
            <TextBlock Style="{StaticResource HintText}"
                       Text="Recommended when your organization's policy prohibits exporting private keys to a .pfx file - the private key never leaves the Windows certificate store."/>
        </StackPanel>

    </StackPanel>
</UserControl>
