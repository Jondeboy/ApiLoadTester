<Window x:Class="ApiLoadTester.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ApiLoadTester.App.ViewModels"
        xmlns:views="clr-namespace:ApiLoadTester.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="API Load Tester" Height="820" Width="1280" MinHeight="600" MinWidth="1000"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="▶  Start Test" Style="{StaticResource PrimaryButton}" Width="120" Margin="0,0,8,0"
                            Command="{Binding StartCommand}"/>
                    <Button Content="■  Stop" Style="{StaticResource SecondaryButton}" Width="90"
                            Command="{Binding StopCommand}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                    <Button Content="Load Scenario..." Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding LoadScenarioCommand}"/>
                    <Button Content="Save Scenario..." Style="{StaticResource SecondaryButton}"
                            Command="{Binding SaveScenarioCommand}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                    <TextBlock Text="Report title" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBox Text="{Binding ReportTitle, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,14,0"/>
                    <TextBlock Text="Customer" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="Export PDF Report" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding ExportPdfCommand}"/>
                    <Button Content="Export CSV" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportCsvCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Left: configuration -->
            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
                <TabControl Margin="8" BorderThickness="0">
                    <TabItem Header="Request">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <views:RequestConfigView DataContext="{Binding RequestConfig}"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Certificate">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <views:CertificateConfigView DataContext="{Binding CertificateConfig}"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Load Options">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <views:LoadOptionsView DataContext="{Binding LoadOptions}"/>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Center: live results -->
            <views:LiveResultsView Grid.Column="1" DataContext="{Binding LiveResults}"/>

            <!-- Right: run history -->
            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1,0,0,0">
                <views:RunHistoryView DataContext="{Binding History}"/>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
            <Grid Margin="12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#333333"/>
                <TextBlock Grid.Column="1" Text="{Binding IsRunning, StringFormat='Running: {0}'}" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="10.5"/>
            </Grid>
        </Border>
    </Grid>
</Window>
