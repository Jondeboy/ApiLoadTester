<UserControl x:Class="ApiLoadTester.App.Views.RunHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ApiLoadTester.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:RunHistoryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Runs This Session" Style="{StaticResource SectionHeaderText}"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding Runs}" SelectedItem="{Binding Selected}"
                 BorderThickness="1" BorderBrush="{StaticResource BorderBrush2}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" FontSize="11.5" TextWrapping="Wrap" Padding="4,3"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" Text="No completed runs yet." Style="{StaticResource HintText}"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                   Visibility="{Binding Runs.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=inverse}"/>
    </Grid>
</UserControl>
