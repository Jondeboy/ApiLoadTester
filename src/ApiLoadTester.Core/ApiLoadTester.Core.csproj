<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The app is Windows-only (WPF + DPAPI + Windows cert store). SupportedOSPlatform alone
         doesn't suppress CA1416 for a plain net10.0 (non -windows) TFM, so silence it explicitly -
         every Windows-only call here (DPAPI, X509Store) is intentional and only ever runs on Windows. -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

</Project>
